APP_SERVER_PORT=8080
LOCAL_SERVER_PORT=8081

# MySQL 连接池与容器映射端口。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_EXPOSED_PORT=3307
MYSQL_DATABASE=game_flow
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=1000

# Redis 连接池。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXPOSED_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4
REDIS_POOL_MAX_WAIT_MS=500ms

# RabbitMQ 消费并发与预取数量。
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_CONCURRENCY=4
RABBITMQ_MAX_CONCURRENCY=16
RABBITMQ_PREFETCH=20

# 生成链路的限流、可靠投递、租约和背压参数。
SUBMIT_USER_RATE_LIMIT=5
SUBMIT_GLOBAL_RATE_LIMIT=300
GENERATION_MAX_RETRIES=3
OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_SECONDS=30
OUTBOX_CONFIRM_TIMEOUT_SECONDS=5
OUTBOX_MAX_BACKOFF_SECONDS=300
OUTBOX_RELAY_FIXED_DELAY_MS=500
TASK_LEASE_DURATION_SECONDS=60
TASK_LEASE_HEARTBEAT_SECONDS=20
TASK_LEASE_HEARTBEAT_THREADS=2
TASK_LEASE_RECOVERY_ENABLED=true
TASK_LEASE_RECOVERY_BATCH_SIZE=50
TASK_LEASE_RECOVERY_FIXED_DELAY_MS=10000
QUEUE_BACKPRESSURE_ENABLED=true
QUEUE_MAX_BACKLOG=5000
QUEUE_BACKLOG_REFRESH_MS=1000
GENERATION_MOCK_ENABLED=false
GENERATION_MOCK_DELAY_MS=1000
GENERATION_MOCK_FAILURE_RATE=0

# 图片对象存储。
MINIO_ENDPOINT=http://minio:9000
MINIO_LOCAL_ENDPOINT=http://127.0.0.1:9100
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aigc

# 图片生成 Provider；密钥应只填写在本地 .env 中。
DEFAULT_IMAGE_PROVIDER=WANX
DASHSCOPE_API_KEY=
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_IMAGE_MODEL=wan2.7-image-pro

COMFYUI_BASE_URL=http://host.docker.internal:8000
COMFYUI_ENABLED=false

TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=20
TOMCAT_ACCEPT_COUNT=500
TOMCAT_MAX_CONNECTIONS=8192
